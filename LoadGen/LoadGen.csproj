<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>loadgen</AssemblyName>
		<RootNamespace>LoadGen</RootNamespace>
		<!-- Генератор не должен сам становиться узким местом. Server GC даёт ему
         пропускную способность; стенду это не мешает — у него свой процесс. -->
		<ServerGarbageCollection>true</ServerGarbageCollection>

		<!-- Глобальный инструмент: dotnet pack + dotnet tool install, команда loadgen. -->
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>loadgen</ToolCommandName>
		<PackageId>DiagLab.LoadGen</PackageId>
		<Version>1.0.0</Version>
		<Description>Генератор HTTP-нагрузки для демо-стенда DiagLab.</Description>
		<PackageOutputPath>./nupkg</PackageOutputPath>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Update="loadgen.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>